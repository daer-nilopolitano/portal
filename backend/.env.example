DJANGO_SECRET_KEY=troque-por-uma-chave-secreta-em-producao
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Com docker-compose, aponta pro serviço "db" (funciona automaticamente).
# Rodando local sem Docker, troque por um Postgres acessível: pode ser um
# Postgres instalado no Windows (ex.: postgres://postgres:SENHA@localhost:5432/daer)
# ou, mais simples já que não tem Postgres instalado, a connection string de
# um projeto gratuito no Neon ou Supabase (o mesmo que será usado em produção).
DATABASE_URL=postgres://postgres:postgres@db:5432/daer

CORS_ALLOWED_ORIGINS=http://localhost:3000

WAGTAILADMIN_BASE_URL=http://localhost:8000
