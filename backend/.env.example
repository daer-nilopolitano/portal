DJANGO_SECRET_KEY=troque-por-uma-chave-secreta-em-producao
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Com docker-compose, aponta pro serviço "db" (funciona automaticamente). Rodando local sem Docker, troque por um
# Postgres acessível: pode ser um Postgres instalado no Windows (ex.: postgres://postgres:SENHA@localhost:5432/daer)
# ou, a connection string de um projeto gratuito no Neon ou Supabase (o mesmo que será usado em produção).
DATABASE_URL=postgres://postgres:postgres@db:5432/daer

CORS_ALLOWED_ORIGINS=http://localhost:3000

WAGTAILADMIN_BASE_URL=http://localhost:8000

# Liga/desliga o "Try it" (requisições reais) na documentação da API (Stoplight Elements, em /api/docs).
# Padrão: ligado (True), em dev e em produção. Defina como False se precisar restringir.
# API_DOCS_TRY_IT=False
